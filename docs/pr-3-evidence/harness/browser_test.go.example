package model_test

import (
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"os"
	"os/exec"
	"strconv"
	"testing"
	"time"

	"github.com/QuantumNous/new-api/model"
	"github.com/google/uuid"
	"github.com/stretchr/testify/require"
)

func reviewBrowser(t *testing.T, userID int, mailID string, clock time.Time) (model.GachaActionIntent, *model.GachaActionResult) {
	t.Helper()
	type committedClaim struct {
		intent model.GachaActionIntent
		result *model.GachaActionResult
	}
	claims := make(chan committedClaim, 1)
	bearer := uuid.NewString()
	static := http.FileServer(http.Dir("/tmp/pr3-ui"))
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/api/user/gacha/profile" && r.URL.Path != "/api/user/gacha/action" {
			static.ServeHTTP(w, r)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		w.Header().Set("Cache-Control", "no-store")
		if r.Header.Get("Authorization") != "Bearer "+bearer {
			w.WriteHeader(401)
			return
		}
		var payload any
		var err error
		switch {
		case r.URL.Path == "/api/user/gacha/profile" && r.Method == "GET":
			payload, err = model.GetGachaProfile(userID, clock)
		case r.URL.Path == "/api/user/gacha/action" && r.Method == "POST":
			var intent model.GachaActionIntent
			decoder := json.NewDecoder(r.Body)
			decoder.DisallowUnknownFields()
			if decoder.Decode(&intent) != nil || intent.ItemID == nil || *intent.ItemID != mailID || intent.Action != "mail_claim" {
				w.WriteHeader(400)
				return
			}
			var result *model.GachaActionResult
			result, err = model.ApplyGachaAction(userID, intent, clock)
			payload = result
			if err == nil {
				select {
				case claims <- committedClaim{intent, result}:
				default:
				}
			}
		default:
			w.WriteHeader(405)
			return
		}
		if err != nil {
			if errors.Is(err, model.ErrGachaMailUnavailable) {
				w.WriteHeader(409)
				json.NewEncoder(w).Encode(map[string]any{"success": false, "code": "ALREADY_CLAIMED"})
			} else {
				w.WriteHeader(500)
			}
			return
		}
		json.NewEncoder(w).Encode(map[string]any{"success": true, "data": payload})
	}))
	defer server.Close()
	cmd := exec.Command("/tmp/pr3-browser/bin/python", "/src/docs/pr-3-evidence/harness/browser.py", server.URL, mailID)
	cmd.Env = append(os.Environ(), "REVIEW_BROWSER_KEY="+bearer, "REVIEW_USER="+strconv.Itoa(userID))
	output, err := cmd.CombinedOutput()
	require.NoError(t, err, "%s", output)
	select {
	case claim := <-claims:
		return claim.intent, claim.result
	default:
		t.Fatal("browser did not submit the claimed attachment")
	}
	return model.GachaActionIntent{}, nil
}
